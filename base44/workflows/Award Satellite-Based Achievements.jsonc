{
  "name": "Award Satellite-Based Achievements",
  "description": "",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"completed\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Trip"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "award_satellite_based_achievements",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkSatelliteAchievements",
            "args": {
              "trip_id": "{{event.entity_id}}"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "checkSatelliteAchievements"
  }
}